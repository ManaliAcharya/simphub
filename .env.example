APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CLIO_BASE_URL=https://app.clio.com
CLIO_API_BASE_URL=https://app.clio.com
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=
CLIO_WEBHOOK_CALLBACK_URL=
CLIO_API_VERSION=4
CLIO_WEBHOOK_MODEL=bill
CLIO_WEBHOOK_EVENTS=created,updated
# Clio's webhook SUBSCRIPTION endpoint only accepts a narrow field whitelist — id/created_at/
# updated_at are fine, but number/total/balance/state/issued_at get rejected with InvalidFields.
# This does NOT limit what ClioApiClient::fetchBill() can request when we re-fetch the bill
# after a webhook fires — that's a separate call with its own broader field list.
CLIO_WEBHOOK_FIELDS=id,created_at,updated_at
CLIO_WEBHOOK_EXPIRY_DAYS=30
# Bill "state" values (case-insensitive) that release the payment-link email — comma-separated.
# Verify against a real Clio webhook payload/API docs before relying on this in production.
CLIO_APPROVED_BILL_STATES=approved
